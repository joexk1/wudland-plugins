    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "wudland hook codex", "timeout": 5 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "wudland hook codex", "timeout": 5 }] }],
